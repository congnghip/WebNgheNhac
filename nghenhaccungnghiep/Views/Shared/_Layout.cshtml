@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var userName = User.Identity?.Name ?? "";
    var initials = userName.Length > 0 ? userName[..1].ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Record</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div id="app">
    <!-- Top Navigation -->
    <header id="topnav">
        <div class="topnav-left">
            <div class="topnav-brand">Record</div>
            <div class="topnav-search-pill">
                <span class="material-symbols-outlined search-icon">search</span>
                <input type="text" id="topnav-search-input" placeholder="Search music..." autocomplete="off" />
                <div id="search-suggestions" class="search-suggestions" style="display:none;"></div>
            </div>
        </div>
        <div class="topnav-right">
            <button class="topnav-icon-btn material-symbols-outlined" id="btn-dark-mode" title="Toggle dark mode">dark_mode</button>
            <div class="topnav-user">
                @if (SignInManager.IsSignedIn(User))
                {
                <button class="topnav-user-chip" type="button" id="btn-user-menu">
                    <div class="topnav-avatar">@initials</div>
                    <span>@userName</span>
                </button>
                <div id="user-dropdown">
                    <a href="#" class="dropdown-item" data-page="studio">
                        <span class="material-symbols-outlined" style="font-size:18px;">mic</span> Studio
                    </a>
                    <a href="#" class="dropdown-item" data-page="artist-profile" id="dropdown-artist-profile" style="display:none;">
                        <span class="material-symbols-outlined" style="font-size:18px;">person</span> Artist Profile
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                    <a href="#" class="dropdown-item" data-page="admin">
                        <span class="material-symbols-outlined" style="font-size:18px;">settings</span> Manage
                    </a>
                    }
                    <a href="#" class="dropdown-item" data-page="settings">
                        <span class="material-symbols-outlined" style="font-size:18px;">settings</span> Settings
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="dropdown-item">
                        <span class="material-symbols-outlined" style="font-size:18px;">logout</span> Logout
                    </a>
                </div>
                }
                else
                {
                <a asp-controller="Account" asp-action="Login" class="topnav-icon-btn material-symbols-outlined" title="Đăng nhập">account_circle</a>
                }
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <aside id="sidebar">
        <div class="sidebar-inner">
            <div class="sidebar-logo">
                <h2>Collector</h2>
                <p>Premium Member</p>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-item active" data-page="home">
                    <span class="material-symbols-outlined">home</span>
                    <span>Home</span>
                </div>
                <div class="nav-item" data-page="library">
                    <span class="material-symbols-outlined">library_music</span>
                    <span>Library</span>
                </div>
                <div class="nav-item" data-page="search">
                    <span class="material-symbols-outlined">search</span>
                    <span>Search</span>
                </div>
                @if (SignInManager.IsSignedIn(User))
                {
                <div class="nav-item" data-page="studio">
                    <span class="material-symbols-outlined">mic</span>
                    <span>Studio</span>
                </div>
                }
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                {
                <div class="nav-item" data-page="admin">
                    <span class="material-symbols-outlined">settings</span>
                    <span>Admin</span>
                </div>
                }
            </nav>

            <div class="sidebar-section-title">
                <span>Playlists</span>
                <button class="sidebar-add-btn" type="button" id="btn-create-playlist" title="Tạo playlist">
                    <span class="material-symbols-outlined" style="font-size:18px;">add</span>
                </button>
            </div>
            <div class="sidebar-section" id="sidebar-playlists">
                <!-- Rendered by JS -->
            </div>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Logout" class="sidebar-footer-item">
                    <span class="material-symbols-outlined" style="font-size:18px;">logout</span>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content">
        @RenderBody()

        <section class="page-section" id="page-search">
            <div class="empty-state-panel">
                <div class="empty-state-icon"><span class="material-symbols-outlined" style="font-size:28px;">search</span></div>
                <p class="eyebrow">Search</p>
                <h1 class="page-title">Search music</h1>
                <p class="page-subtitle">Start typing to find songs and artists.</p>
            </div>
            <div id="search-results"></div>
        </section>

        <section class="page-section" id="page-playlist">
            <!-- Rendered by JS -->
        </section>

        <section class="page-section" id="page-library">
            <div class="empty-state-panel">
                <div class="empty-state-icon"><span class="material-symbols-outlined" style="font-size:28px;">library_music</span></div>
                <p class="eyebrow">Library</p>
                <h1 class="page-title">Your Library</h1>
                <p class="page-subtitle">Your favorites and playlists will appear here.</p>
            </div>
            <div id="library-content"></div>
        </section>

        <section class="page-section" id="page-artist">
            <!-- Rendered by JS -->
        </section>

        <section class="page-section" id="page-artist-profile">
            <!-- Rendered by JS -->
        </section>

        <section class="page-section" id="page-studio">
            <!-- Rendered by JS -->
        </section>

        <section class="page-section" id="page-settings">
            <!-- Rendered by JS -->
        </section>

        <section class="page-section" id="page-admin">
            <!-- Rendered by JS -->
        </section>
    </main>

    <!-- Player Bar -->
    <footer id="player-bar">
        <div class="player-now-playing">
            <div class="player-thumb-wrap">
                <img id="player-thumb" class="player-thumb" src="https://placehold.co/52x52/e3e2e2/1b1c1c?text=♪" alt="Album Art" />
            </div>
            <div class="player-song-info">
                <div class="player-song-title" id="player-title">No song</div>
                <div class="player-song-artist" id="player-artist">—</div>
            </div>
            <button class="player-like-btn" id="btn-like" title="Like">
                <span class="material-symbols-outlined" style="font-size:18px;">favorite</span>
            </button>
        </div>

        <div class="player-controls">
            <div class="player-btns">
                <button class="ctrl-btn" id="btn-shuffle" title="Shuffle">
                    <span class="material-symbols-outlined" style="font-size:20px;">shuffle</span>
                </button>
                <button class="ctrl-btn" id="btn-prev" title="Previous">
                    <span class="material-symbols-outlined" style="font-size:20px;">skip_previous</span>
                </button>
                <button class="ctrl-btn" id="btn-play-pause" title="Play / Pause">
                    <span class="material-symbols-outlined" id="play-icon" style="font-size:24px;">play_arrow</span>
                </button>
                <button class="ctrl-btn" id="btn-next" title="Next">
                    <span class="material-symbols-outlined" style="font-size:20px;">skip_next</span>
                </button>
                <button class="ctrl-btn" id="btn-repeat" title="Repeat">
                    <span class="material-symbols-outlined" style="font-size:20px;">repeat</span>
                </button>
            </div>
            <div class="player-progress">
                <span class="time-label" id="time-current">0:00</span>
                <div class="progress-track" id="progress-track">
                    <div class="progress-fill" id="progress-fill" style="width:0%"></div>
                </div>
                <span class="time-label" id="time-total">0:00</span>
            </div>
        </div>

        <div class="player-extras">
            <button class="ctrl-btn" id="btn-queue" title="Queue">
                <span class="material-symbols-outlined" style="font-size:20px;">queue_music</span>
            </button>
            <button class="ctrl-btn" id="btn-mute" title="Mute">
                <span class="material-symbols-outlined" style="font-size:20px;" id="volume-icon">volume_up</span>
            </button>
            <input type="range" class="volume-slider" id="volume-slider" min="0" max="100" value="75" title="Volume" />
            <button class="ctrl-btn" id="btn-room" title="Listen together">
                <span class="material-symbols-outlined" style="font-size:20px;">group</span>
            </button>
        </div>
    </footer>

    <!-- Room Panel -->
    <div id="room-panel" class="queue-panel" style="display:none;">
        <div class="queue-panel-header">
            <h3>Listen Together</h3>
            <button class="queue-close-btn" id="room-close"><span class="material-symbols-outlined" style="font-size:20px;">close</span></button>
        </div>
        <div class="queue-panel-body" id="room-body" style="padding:16px;">
            <p style="font-size:13px;color:var(--secondary);margin:0 0 12px;">Create or join a room to listen with others in real time.</p>
            <div id="room-status" style="font-size:13px;margin-bottom:12px;"></div>
            <input type="text" id="room-id-input" placeholder="Room code" class="input-field" style="width:100%;padding:10px 14px;border:1px solid var(--outline-variant);border-radius:var(--radius-sm);background:var(--surface-container-low);color:var(--on-surface);font-size:14px;margin-bottom:8px;" />
            <div style="display:flex;gap:8px;">
                <button class="btn-primary" id="btn-room-join" style="flex:1;">Join</button>
                <button class="btn-secondary" id="btn-room-create" style="flex:1;">Create</button>
                <button class="btn-secondary" id="btn-room-leave">Leave</button>
            </div>
        </div>
    </div>

    <!-- Queue Panel -->
    <div id="queue-panel" class="queue-panel" style="display:none;">
        <div class="queue-panel-header">
            <h3>Queue</h3>
            <button class="queue-close-btn" id="queue-close"><span class="material-symbols-outlined" style="font-size:20px;">close</span></button>
        </div>
        <div class="queue-panel-body" id="queue-list">
            <p style="color:var(--secondary);padding:24px;text-align:center;">No songs in queue.</p>
        </div>
    </div>

    <!-- Context Menu -->
    <div id="context-menu" class="context-menu" style="display:none;">
        <div class="context-menu-item" data-action="play"><span class="material-symbols-outlined" style="font-size:18px;">play_arrow</span> Play</div>
        <div class="context-menu-item" data-action="add-queue"><span class="material-symbols-outlined" style="font-size:18px;">queue_music</span> Add to queue</div>
        <div class="context-menu-item" data-action="add-playlist"><span class="material-symbols-outlined" style="font-size:18px;">playlist_add</span> Add to playlist</div>
        <div class="context-menu-item" data-action="edit" id="ctx-edit-song" style="display:none;"><span class="material-symbols-outlined" style="font-size:18px;">edit</span> Edit</div>
        <div class="context-menu-divider"></div>
        <div class="context-menu-item" data-action="artist"><span class="material-symbols-outlined" style="font-size:18px;">person</span> Go to artist</div>
    </div>
</div>

<!-- Mobile Navigation -->
<nav id="mobile-nav">
    <div class="mobile-nav-item active" data-page="home">
        <span class="material-symbols-outlined">home</span>
        <span>Home</span>
    </div>
    <div class="mobile-nav-item" data-page="search">
        <span class="material-symbols-outlined">search</span>
        <span>Search</span>
    </div>
    <div class="mobile-nav-item" data-page="library">
        <span class="material-symbols-outlined">library_music</span>
        <span>Library</span>
    </div>
    @if (SignInManager.IsSignedIn(User))
    {
    <div class="mobile-nav-item" data-page="studio">
        <span class="material-symbols-outlined">mic</span>
        <span>Studio</span>
    </div>
    }
    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
    <div class="mobile-nav-item" data-page="admin">
        <span class="material-symbols-outlined">settings</span>
        <span>Admin</span>
    </div>
    }
</nav>

<!-- Modals -->
<div id="playlist-modal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>New playlist</h3>
            <button type="button" class="modal-close"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            <input type="text" id="playlist-name-input" class="modal-input" placeholder="Playlist name..." />
            <div class="modal-error" id="playlist-error"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="modal-btn-secondary" id="modal-cancel">Cancel</button>
            <button type="button" class="modal-btn-primary" id="modal-confirm">Create</button>
        </div>
    </div>
</div>

<div id="upload-modal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Upload song</h3>
            <button type="button" class="modal-close" id="upload-modal-close"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            <div class="upload-form-group">
                <label class="upload-label">Title</label>
                <input type="text" id="upload-title" class="modal-input" placeholder="Song title" />
            </div>
            <div class="upload-form-group">
                <label class="upload-label">Artist</label>
                <input type="text" id="upload-artist" class="modal-input" placeholder="Artist name" />
            </div>
            <div class="upload-form-group">
                <label class="upload-label">Audio file</label>
                <input type="file" id="upload-file" class="modal-input" accept="audio/*" />
            </div>
            <div class="upload-form-group">
                <label class="upload-label">Cover image <span style="color:var(--secondary);font-weight:400;">(optional)</span></label>
                <input type="file" id="upload-cover" class="modal-input" accept="image/*" />
            </div>
            <div class="upload-progress" id="upload-progress" style="display:none;">
                <div class="upload-progress-bar" id="upload-progress-bar"></div>
            </div>
            <div class="modal-error" id="upload-error"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="modal-btn-secondary" id="upload-cancel">Cancel</button>
            <button type="button" class="modal-btn-primary" id="upload-confirm">Upload</button>
        </div>
    </div>
</div>

<div id="studio-upload-modal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Upload song for review</h3>
            <button type="button" class="modal-close" id="studio-upload-close"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="modal-body">
            <div class="upload-form-group">
                <label class="upload-label">Title</label>
                <input type="text" id="studio-upload-title" class="modal-input" placeholder="Song title" />
            </div>
            <div class="upload-form-group">
                <label class="upload-label">Artist</label>
                <input type="text" id="studio-upload-artist" class="modal-input" placeholder="Artist name" />
            </div>
            <div class="upload-form-group">
                <label class="upload-label">Audio file</label>
                <input type="file" id="studio-upload-file" class="modal-input" accept="audio/*" />
            </div>
            <div class="upload-form-group">
                <label class="upload-label">Cover image <span style="color:var(--secondary);font-weight:400;">(optional)</span></label>
                <input type="file" id="studio-upload-cover" class="modal-input" accept="image/*" />
            </div>
            <div class="upload-progress" id="studio-upload-progress" style="display:none;">
                <div class="upload-progress-bar" id="studio-upload-progress-bar"></div>
            </div>
            <div class="modal-error" id="studio-upload-error"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="modal-btn-secondary" id="studio-upload-cancel">Cancel</button>
            <button type="button" class="modal-btn-primary" id="studio-upload-confirm">Submit for review</button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="~/js/api.js" asp-append-version="true"></script>
<script src="~/js/player.js" asp-append-version="true"></script>
<script src="~/js/ui-effects.js" asp-append-version="true"></script>
<script src="~/js/home.js" asp-append-version="true"></script>
<script src="~/js/playlist.js" asp-append-version="true"></script>
<script src="~/js/library.js" asp-append-version="true"></script>
<script src="~/js/room.js" asp-append-version="true"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
